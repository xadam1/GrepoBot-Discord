# GrepoBot Discord bot settings. Lives on the Pi as /etc/grepobot-discord/grepobot-discord.env (root only).
# After editing: sudo systemctl restart grepobot-discord

# Bot token: https://discord.com/developers/applications -> GrepoBot -> Bot -> Reset Token
Discord__Token=

# Server ID: Discord -> User Settings -> Advanced -> Developer Mode on, then right click the server -> Copy Server ID
Discord__GuildId=

# Optional: text under the bot's name
#Discord__Status=Watching over the GrepoBot community
