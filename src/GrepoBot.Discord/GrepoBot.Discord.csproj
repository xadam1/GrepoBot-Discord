<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyName>GrepoBot.Discord</AssemblyName>
    <RootNamespace>GrepoBot.Discord</RootNamespace>
    <!-- Real globalization (ICU): Discord.Net creates the server's locale culture, and accent-insensitive
         keyword matching needs Unicode normalization. install.sh installs libicu on the Pi. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Keeps the memory use low on the Raspberry Pi 3B+ (1 GB RAM). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <!-- Draws the personal welcome card. The Linux assets carry libSkiaSharp for the Pi (linux-arm64). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Local test settings (token, test server) are used by dotnet run but never published to the Pi. -->
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GrepoBot.Discord.Tests" />
  </ItemGroup>

</Project>
